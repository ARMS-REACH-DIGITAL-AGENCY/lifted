# ─────────────────────────────────────────────────────────────────────────────
# Liftêd™ Environment Variables
# Firebase Project: lifted-production-717
# Web App: Liftêd Web
#
# DO NOT commit real values to this file or to the repository.
# Set all values in Vercel → Settings → Environment Variables.
# For local development, copy this file to .env.local and fill in real values.
# .env.local is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Client SDK (VITE_ prefix = exposed to browser) ──────────────────
# Source: Firebase Console → lifted-production-717 → Project Settings
#         → Your Apps → Liftêd Web → SDK setup and configuration
# Set in: Vercel Environment Variables (all environments)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=lifted-production-717.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lifted-production-717
VITE_FIREBASE_STORAGE_BUCKET=lifted-production-717.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server-side only, never exposed to browser) ───────────
# Source: Firebase Console → lifted-production-717 → Project Settings
#         → Service Accounts → Generate new private key
#         Base64-encode the downloaded JSON: base64 -i serviceAccountKey.json
# Set in: Vercel Environment Variables (Production + Preview, NOT client)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=lifted-production-717.appspot.com

# ── Neon / Postgres ───────────────────────────────────────────────────────────
# Source: Neon Console → lifted project → Connection Details
#         Use the "main" branch connection string for production.
#         Use the "dev" branch connection string for preview/development.
# Set in: Vercel Environment Variables
#         Production environment  → main branch connection string
#         Preview environment     → dev branch connection string
DATABASE_URL=
# Optional aliases (the server checks all of these in order):
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# ── HighLevel (GoHighLevel) ───────────────────────────────────────────────────
# Source: HighLevel → Settings → Integrations → API Keys
# Set in: Vercel Environment Variables (Production + Preview)
HIGHLEVEL_API_KEY=
HIGHLEVEL_LOCATION_ID=aONTFrcg4GyEubg0xdwW

# HighLevel Pipeline IDs (get these after creating the pipelines in HighLevel)
# Investor pipeline: Access Requested → Under Review → Approved → Invitation Sent
#                    → Portal Accessed → Call Scheduled → Follow-Up → Not Approved
HIGHLEVEL_INVESTOR_PIPELINE_ID=
HIGHLEVEL_INVESTOR_STAGE_ACCESS_REQUESTED=

# Wholesale pipeline: Wholesale Inquiry → Application Received → Qualification Review
#                     → Intro Call Scheduled → Samples/Line Sheet Sent
#                     → Wholesale Account Approved → Opening Order Pending
#                     → Opening Order Placed → Active Retailer → Reorder Follow-Up → Not Qualified
HIGHLEVEL_WHOLESALE_PIPELINE_ID=
HIGHLEVEL_WHOLESALE_STAGE_APPLICATION_RECEIVED=

# ── Application ──────────────────────────────────────────────────────────────
# The public URL of the deployed site (used in invitation email links)
# Set in: Vercel Environment Variables
APP_URL=https://wearliftedtoday.com

# ── Cloud Functions (set in Firebase Functions config, not Vercel) ────────────
# These are set via: firebase functions:config:set
# Or as environment variables in the Firebase Console → Functions → Configuration
# DATABASE_URL=<neon-main-branch-connection-string>
# APP_URL=https://wearliftedtoday.com
